	measure 'Revenue ly' = ```
			
			CALCULATE ( 
			    [Revenue], 
			    SAMEPERIODLASTYEAR ( 'Calendar'[Date]) 
			)
			```
		lineageTag: 3dcb31f9-156a-4061-b583-70750b041bfa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Varfromly(Revenue) = [Revenue] - [Revenue ly]
		lineageTag: fc2f777a-629f-494d-845a-e71044f238d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Var%(Revenue) = DIVIDE([Varfromly(Revenue)], [Revenue ly])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 38537228-b58f-4949-9a54-77deeeac23aa

	measure 'Revenue Showvar' =
			
			IF (
			    AND (
			        ISFILTERED ( 'Calendar'[year] ),
			        SELECTEDVALUE ( 'Calendar'[year] ) <> 2010
			    ),
			    FORMAT ( [Var%(Revenue)], "$#,0" ) & "  |  "
			        & FORMAT ( [Var%(Revenue)], "#0.0%" ),
			    ""
			)
		lineageTag: 6c19b78f-fda0-4039-bf98-089e84fc5c3e

	measure ArrowRevenue =
			
			IF (
			    ISFILTERED ( 'Calendar'[year] ) && [Varfromly(Revenue)] > 0 && SELECTEDVALUE ( 'Calendar'[year] ) <> 2010,
			    UNICHAR ( 9650 ),
			    IF (
			        ISFILTERED ( 'Calendar'[year] ) && [Varfromly(Revenue)] < 0 && SELECTEDVALUE ( 'Calendar'[year] ) <> 2010,
			        UNICHAR ( 9660 ),
			        ""
			    )
			)
		lineageTag: 692e0666-ad37-470f-8e1a-c9ec5d8682ba

	measure 'ARROW Color (cost)' = IF([Varfromly(cost)] > 0, 1, 2)
