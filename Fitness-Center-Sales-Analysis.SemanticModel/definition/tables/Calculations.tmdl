	measure YTD =
			
			IF (
			    SELECTEDVALUE ( 'TIME ANALYSIS'[TIME ANALYSIS Order] ) = 0,
			    [REVENUE YTD],
			    IF (
			        SELECTEDVALUE ( 'TIME ANALYSIS'[TIME ANALYSIS Order] ) = 1,
			        [Profit YTD],
			        [Cost YTD]
			    )
			)
		displayFolder: Time Analysis Measures
