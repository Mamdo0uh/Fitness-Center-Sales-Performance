table 'Return_Measures '
	lineageTag: f3761dfb-6076-4fff-b216-38b76ece88f5

	measure 'Returns Amount' = SUM(SalesReturns[ReturnAmount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: bd0e72ee-975e-4651-9fc5-b88651aedb55

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'QTY RETURNES' = SUM(SalesReturns[ReturnQuantity])
		formatString: 0
		lineageTag: aef63cf9-9d47-4f16-a428-d9506851f6f6

	measure '#orders Returns' = DISTINCTCOUNT(SalesReturns[SalesOrderNumber])
		formatString: 0
		lineageTag: 8753ea0d-f46e-4f73-b7fb-5898915edf9f

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '#Customers returns' = DISTINCTCOUNT(SalesReturns[CustomerKey])
		formatString: 0
		lineageTag: cfcbf2be-ccb2-418f-88f3-9e30297c1348

	measure '%returns Amount' = DIVIDE([Returns Amount], [Revenue])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 623f13e2-3885-40d9-a5fd-79e54b823508

	measure '%returns QTY' = DIVIDE([QTY RETURNES], [QTY])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4721499d-f572-4a28-8ab4-82ec66912cac

	measure '%returns ORDERS' = DIVIDE([#orders Returns], [#Orders])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3b86ba54-6154-4c7c-b320-525e45932efd

	measure '%returns Customers' = DIVIDE([#Customers returns], [#Customers])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5f2912c7-353e-4390-9d9c-b8d5e33c5bb5

	column Column1
		dataType: string
		lineageTag: 5d752704-c76c-44e6-9764-5a2858ed328c
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

